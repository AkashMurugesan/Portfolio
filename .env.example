# Copy to .env.local and fill in. Never commit real values.

# --- Database ---
# Leave DATABASE_URL unset to use embedded PGlite at ./.data/pglite (local dev).
# Set it for Neon / docker compose / production, e.g.:
# DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
# PGLITE_DIR=./.data/pglite

# --- Auth (Auth.js + GitHub OAuth) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Required when self-hosting (next start, Docker, VPS). Vercel sets this automatically.
AUTH_TRUST_HOST=true
# GitHub OAuth App: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Your numeric GitHub user id (only this account can sign in):
#   curl https://api.github.com/users/<your-username>  -> "id"
ADMIN_GITHUB_ID=
